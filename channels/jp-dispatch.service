[Unit]
Description=JP local dispatch socket (fenced migration candidate)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/jp-dispatch/current/dispatch_service.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=jp-dispatch
RuntimeDirectoryMode=0755
StateDirectory=jp-dispatch
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
LockPersonality=yes
MemoryMax=320M
TasksMax=8
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
