[Unit]
Description=Individual domain permission bridge
[Socket]
ListenStream=/var/lib/jp-migracao-revisao/core-model/task-effects.sock
ExecStartPost=/usr/bin/chown 64681:64681 /var/lib/jp-migracao-revisao/core-model/task-effects.sock
SocketMode=0600
RemoveOnStop=yes
[Install]
WantedBy=sockets.target
